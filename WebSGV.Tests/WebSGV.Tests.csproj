<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>WebSGV.Tests</RootNamespace>
    <!-- E6-2: todo aviso (compilador y analizadores de xUnit) rompe la compilación. La auditoría de
         paquetes NuGet (NU1901-NU1904) sigue como aviso también en la restauración: la decide el CI
         con /warnaserror:NU1903,NU1904. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <!-- Misma versión que WebSGV/packages.config: para leer los .xlsx que generan los servicios -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- Misma versión que WebSGV/packages.config: para generar el PDF de la Orden de Viaje en los tests -->
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <!-- Misma versión que WebSGV/packages.config: para leer los historiales GPS guardados (Datos/Trazabilidad) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Misma versión que WebSGV/packages.config: para generar el QR del segundo factor en las pruebas (E4-14) -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Transactions" />
    <!-- HttpRequestBase falso (IpClienteHelperTests) -->
    <Reference Include="System.Web" />
    <!-- Para armar un .docx de prueba en memoria (LectorProgramacionWord) -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="WebSGV">
      <HintPath>..\WebSGV\bin\WebSGV.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Historiales GPS reales y horas que marcó la administradora (TrazabilidadCargaTests) -->
    <None Include="Datos\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
