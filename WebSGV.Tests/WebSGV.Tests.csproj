<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>WebSGV.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelNumberFormat" Version="1.2.0" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Misma versión que WebSGV/packages.config: para leer los .xlsx que generan los servicios -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Misma versión que WebSGV/packages.config: para generar el PDF de la Orden de Viaje en los tests -->
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
    <!-- Misma versión que WebSGV/packages.config: para leer los historiales GPS guardados (Datos/Trazabilidad) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Misma versión que WebSGV/packages.config: para generar el QR del segundo factor en las pruebas (E4-14) -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Transactions" />
    <!-- HttpRequestBase falso (IpClienteHelperTests) -->
    <Reference Include="System.Web" />
    <!-- Para armar un .docx de prueba en memoria (LectorProgramacionWord) -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="WebSGV">
      <HintPath>..\WebSGV\bin\WebSGV.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Historiales GPS reales y horas que marcó la administradora (TrazabilidadCargaTests) -->
    <None Include="Datos\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
