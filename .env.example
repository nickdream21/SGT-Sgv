# Copia este archivo como .env y completa los valores reales.
# Usado SOLO por Azure Data API Builder (dab-config.json), no por la web app.
DATABASE_CONNECTION_STRING=Data Source=<servidor>;Initial Catalog=<bd>;User ID=<usuario>;Password=<password>;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;
