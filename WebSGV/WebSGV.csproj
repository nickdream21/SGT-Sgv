  <!-- Candado de publicación (WPP: carpeta, FTP, Web Deploy): nunca subir los datos locales
       (App_Data: PDFs firmados, Uploads: adjuntos) ni los .sql de Database\, que el sitio no lee.
       Vale aunque un .pubxml local tenga ExcludeApp_Data=false. Lo fija ConfiguracionSeguridadTests. -->
  <ItemGroup>
