<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<!-- Credenciales de BD en archivo aparte (gitignorado). Copiar connectionStrings.config.example -->
	<connectionStrings configSource="connectionStrings.config" />

	<appSettings file="appSettings.Secrets.config">
		<!-- Estas claves NO son sensibles y se quedan aquí -->
		<!-- Las claves SMTP ahora se cargan desde appSettings.Secrets.config -->
		<!-- ApisPeruToken (consulta de DNI/RUC de RegistroChoferes y RegistroClientes) también va en
		     appSettings.Secrets.config: <add key="ApisPeruToken" value="(token de apisperu.com)" />.
		     Sin ella la página avisa "La consulta de DNI/RUC no está configurada" y se escribe a mano. -->

		<!-- ============================================================= -->
		<!-- Datos corporativos de Viviana (usados en PDFs / formatos)     -->
		<!-- Estos NO son sensibles: son los mismos datos que aparecen en  -->
		<!-- comprobantes tributarios públicos emitidos por la empresa.    -->
		<!-- ============================================================= -->
		<add key="Empresa.RazonSocial"   value="SERVICIOS GENERALES VIVIANA E.I.R.L." />
		<add key="Empresa.Rubro"         value="Transporte y Construcción" />
		<add key="Empresa.Ruc"           value="20483851171" />
		<add key="Empresa.DomicilioFiscal" value="Jr. Cañete Nro. 416 Dpto. 100 - Cercado de Lima, Lima" />
		<add key="Empresa.Web"           value="sgvtransporte.somee.com" />

		<!-- Ruta (relativa a ~/App_Data) donde se archivan los PDFs firmados -->
		<add key="OrdenViaje.RutaArchivo" value="~/App_Data/OrdenesViaje" />

		<!-- "Dinero y pagos del viaje" (MovimientosViaje.aspx): apagada por decisión del usuario (2026-11-13).
		     true = vuelven el menú, la pantalla, la tabla de la revisión y el panel del conductor. -->
		<add key="MovimientosViaje.Habilitado" value="false" />

		<!-- Los conductores todavía liquidan en papel (decisión del usuario 2026-11-13): en false, cada corrida del
		     GPS automático cierra los viajes de liquidación ABIERTO (no toca despachos ni seguimiento GPS).
		     Poner true el día que los conductores empiecen a liquidar en el sistema. -->
		<add key="Liquidaciones.ConductoresEnSistema" value="false" />

		<!-- URL pública del sistema (sin "/" final) usada en los enlaces de recuperación de
		     contraseña. Vacía aquí = usa el host del request (desarrollo local).
		     Producción: la fija Web.Release.config (https://sgvtransporte.somee.com). -->
		<add key="App.UrlPublica" value="" />

		<!-- Contraseñas (PasswordHelper): iteraciones de PBKDF2-SHA256 para los hashes nuevos
		     (mínimo 100000; subirlo convierte los hashes al siguiente inicio de sesión, nunca los baja). -->
		<add key="Seguridad.IteracionesContrasena" value="310000" />
		<!-- true = al iniciar sesión, el hash del formato anterior (PBKDF2-SHA1, 10000 iteraciones) se
		     reescribe en el formato nuevo (sha256.). Aquí (local/Debug) va en false porque la BD de pruebas
		     la usa también el sitio publicado; Web.Release.config lo pone en true.
		     OJO: este flag SOLO frena la conversión al iniciar sesión. Crear, cambiar o restablecer una
		     contraseña SIEMPRE escribe el formato nuevo, que un DLL anterior a esta versión no lee (esa
		     cuenta no podría entrar con él). En producción: publicar antes de que alguien cambie su
		     contraseña y no volver a publicar un DLL anterior. -->
		<add key="Seguridad.ConvertirHashAlIngresar" value="false" />
		<!-- true = quien inicia sesión con una contraseña que no cumple las reglas de PoliticaContrasena
		     (10 caracteres, sin su nombre/usuario/DNI, sin secuencias ni contraseñas comunes) debe
		     cambiarla antes de seguir (modal obligatorio; no se guarda nada en la BD). false = no cambia nada. -->
		<add key="Seguridad.ExigirPoliticaAlIngresar" value="false" />
		<!-- Segundo factor (E4-14, U-079). false = voluntario: administración, supervisor, contabilidad y administrador de
		     sistema pueden activarlo en Mi seguridad, y quien lo activó da el código al entrar. true = obligatorio para esos
		     roles: quien no lo tiene lo configura antes de poder entrar (nunca los conductores). Requiere la clave
		     Seguridad.ClaveSegundoFactor en appSettings.Secrets.config (la misma en todas las copias contra la misma BD). -->
		<add key="Seguridad.ExigirSegundoFactor" value="false" />

		<!-- Respaldo de compresión (E5-7, Helpers/CompresionRespuesta.cs). false = solo la compresión de IIS
		     (urlCompression, abajo). true = gzip propio del HTML, JSON y texto (nunca descargas ni parciales de
		     UpdatePanel). Se enciende solo si, tras publicar, el HTML de Login llega sin Content-Encoding: gzip
		     (paso "Medir gzip" de herramientas/publicar/README.md). -->
		<add key="Compresion.Respuesta" value="false" />

		<!-- Aviso por correo de los errores no controlados (AvisoErrores, Global.asax; ver docs/OPERACION.md).
		     Varios destinatarios separados por comas; vacío = no se envía. Usa el SMTP de appSettings.Secrets.config
		     (SmtpHost, SmtpPort, SmtpSSL, SmtpUser, SmtpPass y SmtpFrom: el remitente; sin SmtpFrom se usa SmtpUser). -->
		<add key="AvisoErroresPara" value="sistemas.cibertic@serviciosgeneralesviviana.com" />
	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<!-- enableVersionHeader="false": sin cabecera X-AspNet-Version -->
		<httpRuntime targetFramework="4.8" enableVersionHeader="false" />
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="es-PE" uiCulture="es-PE" />

		<!-- ERRORES: Off en local para ver detalles; en Release se activa RemoteOnly via transform -->
		<customErrors mode="Off">
			<error statusCode="404" redirect="~/Views/Error404.aspx" />
		</customErrors>

		<!-- SESIÓN: Timeout de 30 min, nombre de cookie personalizado y regenerable -->
		<sessionState
   mode="InProc"
   timeout="30"
   cookieName="SGV_SessionId"
   cookieSameSite="Lax"
   regenerateExpiredSessionId="true" />

		<!-- Sin trace.axd ni traza en las páginas (explícito; publicar.ps1 rechaza un paquete con enabled="true") -->
		<trace enabled="false" />

		<!-- COOKIES: HttpOnly evita acceso JS, SameSite previene CSRF -->
		<!-- requireSSL se activa en producción vía Web.Release.config transform -->
		<httpCookies httpOnlyCookies="true" sameSite="Lax" />

		<pages>
			<namespaces>
				<add namespace="System.Web.Routing" />
			</namespaces>
		</pages>
		<!-- Sin la página de documentación de los .asmx (no exponer los métodos web) -->
		<webServices>
			<protocols>
				<remove name="Documentation" />
			</protocols>
		</webServices>
	</system.web>
	<system.webServer>
		<validation validateIntegratedModeConfiguration="false" />

		<!-- Cabeceras de seguridad de todo el sitio, en un solo lugar (no agregarlas desde C#).
			 Redireccionamiento HTTPS y HSTS: solo en producción (Web.Release.config).
			 La cabecera "Server" la quita Global.asax (Application_PreSendRequestHeaders). -->
		<httpProtocol>
			<customHeaders>
				<remove name="X-Powered-By" />
				<remove name="X-Frame-Options" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<remove name="X-Content-Type-Options" />
				<add name="X-Content-Type-Options" value="nosniff" />
				<remove name="Referrer-Policy" />
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
				<!-- E4-5. CSP aplicada: solo lo que hoy ya se cumple (sin <object>/<embed>, sin <base>, formularios al
					 mismo sitio y sin mostrarse en marcos de otro origen). La de scripts, estilos e imágenes va solo en
					 informe hasta E4-15: WebForms exige 'unsafe-inline', y falta 'unsafe-eval' a propósito, para medir los
					 eval: MicrosoftAjax (cada página con ScriptManager), WebUIValidation y AutoPostBack/UpdatePanel
					 (setTimeout('...')). Los informes llegan a CspInforme.ashx (log, sin querystring, una vez por hora cada uno).
					 Solo report-uri, sin report-to/Reporting-Endpoints: con report-to Chrome ignora report-uri y la Reporting
					 API solo entrega por https, en lotes de ~60 s. report-uri apunta a la raíz del dominio (el sitio vive en
					 la raíz en somee e IIS Express); si un día se publica en un subdirectorio virtual, cambiar la ruta. -->
				<remove name="Content-Security-Policy" />
				<add name="Content-Security-Policy" value="frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" />
				<remove name="Content-Security-Policy-Report-Only" />
				<add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self'; frame-src 'self'; worker-src 'self' blob:; report-uri /CspInforme.ashx" />
				<!-- Sin getUserMedia en el sitio: la foto del celular es un <input type="file">, que no depende de esta política. -->
				<remove name="Permissions-Policy" />
				<add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-write=(self)" />
				<!-- Sin Cross-Origin-Embedder-Policy: bloquearía las teselas de OpenStreetMap del mapa. -->
				<remove name="Cross-Origin-Opener-Policy" />
				<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				<remove name="Cross-Origin-Resource-Policy" />
				<add name="Cross-Origin-Resource-Policy" value="same-origin" />
			</customHeaders>
		</httpProtocol>

		<!-- ERRORES IIS: Detailed en desarrollo para ver YSOD nativo de ASP.NET con stack completo.
			 Cambiar a Custom + PassThrough en Release. -->
		<httpErrors errorMode="Detailed">
			<remove statusCode="404" />
			<remove statusCode="500" />
			<error statusCode="404" path="/Views/Error404.aspx" responseMode="ExecuteURL" />
			<error statusCode="500" path="/Views/Error.aspx" responseMode="ExecuteURL" />
		</httpErrors>

		<!-- Archivos subidos (facturas, CPIC, manifiestos): NO se sirven por URL directa (404).
			 Se descargan solo vía Views/DescargarDocumento.aspx, que exige sesión y una llave
			 emitida por la página que mostró el documento (Helpers/DocumentoHelper.cs). -->
		<security>
			<requestFiltering>
				<hiddenSegments>
					<add segment="Uploads" />
				</hiddenSegments>
			</requestFiltering>
		</security>

		<modules runAllManagedModulesForAllRequests="true" />
		<!-- E5-7. Compresión gzip de IIS: estáticos (CSS, JS) y dinámicos (páginas, ScriptResource.axd, parciales de
		     UpdatePanel, JSON). Si el servidor no tiene el módulo dinámico, el HTML sale sin comprimir: ver
		     Compresion.Respuesta en appSettings. Lo fija PrimerIngresoLivianoTests. -->
		<urlCompression doStaticCompression="true" doDynamicCompression="true" />
		<defaultDocument>
			<files>
				<clear />
				<add value="Views/Login.aspx" />
			</files>
		</defaultDocument>
		<!-- Fuentes de Font Awesome servidas desde Content/lib (algunos IIS no traen woff/woff2). -->
		<staticContent>
			<remove fileExtension=".woff" />
			<remove fileExtension=".woff2" />
			<mimeMap fileExtension=".woff" mimeType="font/woff" />
			<mimeMap fileExtension=".woff2" mimeType="font/woff2" />
		</staticContent>
	</system.webServer>

	<!-- E5-7. Content y Scripts: el navegador los guarda 365 días sin volver a preguntar. Es seguro porque toda
	     referencia desde las páginas lleva ?v=fecha del archivo (RecursoHelper.Url; lo fija PrimerIngresoLivianoTests)
	     y las librerías de Content/lib llevan la versión en el nombre de la carpeta (fuentes de Font Awesome e
	     imágenes de Leaflet incluidas). Librerías servidas desde el sitio y no de un CDN, para que la pantalla del
	     conductor cargue con mala señal. -->
	<location path="Content">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>
	<location path="Scripts">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>
	<!-- Excepciones (7 días): los pide el ScriptManager sin ?v= (recurso "jquery" de App_Start/BundleConfig.cs y los
	     scripts de WebForms del paquete NuGet) y la plantilla de Excel, que no tiene versión en el nombre. -->
	<location path="Scripts/jquery-si-falta.js">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>
	<location path="Scripts/WebForms">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>

	<!-- Límites de envío (tarea 14). ASP.NET (maxRequestLength, KB) va SIEMPRE por debajo de IIS
	     (maxAllowedContentLength, bytes): así un envío demasiado grande lo corta ASP.NET con
	     "Maximum request length exceeded", que Global.asax devuelve a la misma página con
	     ?aviso=archivo_grande, y no IIS con su pantalla 404.13. El resto del sitio queda con los
	     4 MB por defecto. Lo pinnea ConfiguracionSeguridadTests. -->
	<!-- Páginas que reciben varios archivos a la vez (ZIP del correo, PDF de SUNAT): hasta 50 MB por envío. -->
	<location path="Views/BandejaDocumentos.aspx">
		<system.web>
			<httpRuntime maxRequestLength="51200" executionTimeout="300" />
		</system.web>
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="57671680" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>
	<location path="Views/FacturasFlete.aspx">
		<system.web>
			<httpRuntime maxRequestLength="51200" executionTimeout="300" />
		</system.web>
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="57671680" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>
	<!-- Documentos adjuntos (factura, CPIC, manifiestos: 10 MB cada uno) y documentos del pedido
	     (hasta 20 MB): 25 MB por envío. -->
	<location path="Views/RegistroDespacho.aspx">
		<system.web>
			<httpRuntime maxRequestLength="25600" executionTimeout="300" />
		</system.web>
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="31457280" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>
	<location path="Views/ListaDespachos.aspx">
		<system.web>
			<httpRuntime maxRequestLength="25600" executionTimeout="300" />
		</system.web>
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="31457280" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>
	<!-- Excel del seguimiento de exportación (B6-3): el archivo hasta 10 MB; 12 MB por envío. -->
	<location path="Views/Exportacion/ImportarSeguimiento.aspx">
		<system.web>
			<httpRuntime maxRequestLength="12288" executionTimeout="300" />
		</system.web>
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="15728640" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>
	<!-- Captura del Yape o comprobante de "Dinero y pagos del viaje" (B6-8): el archivo hasta 5 MB; 6 MB por envío. -->
	<location path="Views/MovimientosViaje.aspx">
		<system.web>
			<httpRuntime maxRequestLength="6144" />
		</system.web>
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="8388608" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.6.0" newVersion="4.0.6.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime> 
	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701;612;618" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
			<compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008,40000,40008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
		</compilers>
	</system.codedom>
	<system.web.extensions>
		<scripting>
			<webServices>
				<!-- Los [WebMethod] de las páginas responden con JSON; el límite por defecto (100 KB) no
				     alcanza para el recorrido GPS del mapa de SeguimientoViaje (dos tramos de hasta 2 500 puntos). -->
				<jsonSerialization maxJsonLength="4194304" />
			</webServices>
		</scripting>
	</system.web.extensions>
</configuration>