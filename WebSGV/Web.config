<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<!-- Credenciales de BD en archivo aparte (gitignorado). Copiar connectionStrings.config.example -->
	<connectionStrings configSource="connectionStrings.config" />

	<appSettings file="appSettings.Secrets.config">
		<!-- Estas claves NO son sensibles y se quedan aquí -->
		<!-- Las claves SMTP ahora se cargan desde appSettings.Secrets.config -->

		<!-- ============================================================= -->
		<!-- Datos corporativos de Viviana (usados en PDFs / formatos)     -->
		<!-- Estos NO son sensibles: son los mismos datos que aparecen en  -->
		<!-- comprobantes tributarios públicos emitidos por la empresa.    -->
		<!-- ============================================================= -->
		<add key="Empresa.RazonSocial"   value="SERVICIOS GENERALES VIVIANA E.I.R.L." />
		<add key="Empresa.Rubro"         value="Transporte y Construcción" />
		<add key="Empresa.Ruc"           value="20483851171" />
		<add key="Empresa.DomicilioFiscal" value="Jr. Cañete Nro. 416 Dpto. 100 - Cercado de Lima, Lima" />
		<add key="Empresa.Web"           value="sgvtransporte.somee.com" />

		<!-- Ruta (relativa a ~/App_Data) donde se archivan los PDFs firmados -->
		<add key="OrdenViaje.RutaArchivo" value="~/App_Data/OrdenesViaje" />

		<!-- "Dinero y pagos del viaje" (MovimientosViaje.aspx): apagada por decisión del usuario (2026-11-13).
		     true = vuelven el menú, la pantalla, la tabla de la revisión y el panel del conductor. -->
		<add key="MovimientosViaje.Habilitado" value="false" />

		<!-- Los conductores todavía liquidan en papel (decisión del usuario 2026-11-13): en false, cada corrida del
		     GPS automático cierra los viajes de liquidación ABIERTO (no toca despachos ni seguimiento GPS).
		     Poner true el día que los conductores empiecen a liquidar en el sistema. -->
		<add key="Liquidaciones.ConductoresEnSistema" value="false" />

		<!-- URL pública del sistema (sin "/" final) usada en los enlaces de recuperación de
		     contraseña. Vacía aquí = usa el host del request (desarrollo local).
		     Producción: la fija Web.Release.config (https://sgvtransporte.somee.com). -->
		<add key="App.UrlPublica" value="" />

		<!-- Contraseñas (PasswordHelper): iteraciones de PBKDF2-SHA256 para los hashes nuevos
		     (mínimo 100000; subirlo convierte los hashes al siguiente inicio de sesión, nunca los baja). -->
		<add key="Seguridad.IteracionesContrasena" value="310000" />
		<!-- true = al iniciar sesión, el hash del formato anterior (PBKDF2-SHA1, 10000 iteraciones) se
		     reescribe en el formato nuevo (sha256.). Aquí (local/Debug) va en false porque la BD de pruebas
		     la usa también el sitio publicado; Web.Release.config lo pone en true.
		     OJO: este flag SOLO frena la conversión al iniciar sesión. Crear, cambiar o restablecer una
		     contraseña SIEMPRE escribe el formato nuevo, que un DLL anterior a esta versión no lee (esa
		     cuenta no podría entrar con él). En producción: publicar antes de que alguien cambie su
		     contraseña y no volver a publicar un DLL anterior. -->
		<add key="Seguridad.ConvertirHashAlIngresar" value="false" />
	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<!-- enableVersionHeader="false": sin cabecera X-AspNet-Version -->
		<httpRuntime targetFramework="4.8" enableVersionHeader="false" />
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="es-PE" uiCulture="es-PE" />

		<!-- ✅ ERRORES: Off en local para ver detalles; en Release se activa RemoteOnly via transform -->
		<customErrors mode="Off">
			<error statusCode="404" redirect="~/Views/Error404.aspx" />
		</customErrors>

		<!-- ✅ SESIÓN: Timeout de 30 min, nombre de cookie personalizado y regenerable -->
		<sessionState
   mode="InProc"
   timeout="30"
   cookieName="SGV_SessionId"
   regenerateExpiredSessionId="true" />

		<!-- ✅ COOKIES: HttpOnly evita acceso JS, SameSite previene CSRF -->
		<!-- requireSSL se activa en producción vía Web.Release.config transform -->
		<httpCookies httpOnlyCookies="true" sameSite="Lax" />

		<pages>
			<namespaces>
				<add namespace="System.Web.Routing" />
			</namespaces>
		</pages>
		<!-- Sin la página de documentación de los .asmx (no exponer los métodos web) -->
		<webServices>
			<protocols>
				<remove name="Documentation" />
			</protocols>
		</webServices>
	</system.web>
	<system.webServer>
		<validation validateIntegratedModeConfiguration="false" />

		<!-- Cabeceras de seguridad de todo el sitio, en un solo lugar (no agregarlas desde C#).
			 Redireccionamiento HTTPS y HSTS: solo en producción (Web.Release.config).
			 La cabecera "Server" la quita Global.asax (Application_PreSendRequestHeaders). -->
		<httpProtocol>
			<customHeaders>
				<remove name="X-Powered-By" />
				<remove name="X-Frame-Options" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<remove name="X-Content-Type-Options" />
				<add name="X-Content-Type-Options" value="nosniff" />
				<remove name="Referrer-Policy" />
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
			</customHeaders>
		</httpProtocol>

		<!-- ✅ ERRORES IIS: Detailed en desarrollo para ver YSOD nativo de ASP.NET con stack completo.
			 Cambiar a Custom + PassThrough en Release. -->
		<httpErrors errorMode="Detailed">
			<remove statusCode="404" />
			<remove statusCode="500" />
			<error statusCode="404" path="/Views/Error404.aspx" responseMode="ExecuteURL" />
			<error statusCode="500" path="/Views/Error.aspx" responseMode="ExecuteURL" />
		</httpErrors>

		<!-- Archivos subidos (facturas, CPIC, manifiestos): NO se sirven por URL directa (404).
			 Se descargan solo vía Views/DescargarDocumento.aspx, que exige sesión y una llave
			 emitida por la página que mostró el documento (Helpers/DocumentoHelper.cs). -->
		<security>
			<requestFiltering>
				<hiddenSegments>
					<add segment="Uploads" />
				</hiddenSegments>
			</requestFiltering>
		</security>

		<modules runAllManagedModulesForAllRequests="true" />
		<defaultDocument>
			<files>
				<clear />
				<add value="Views/Login.aspx" />
			</files>
		</defaultDocument>
		<!-- Fuentes de Font Awesome servidas desde Content/lib (algunos IIS no traen woff/woff2). -->
		<staticContent>
			<remove fileExtension=".woff" />
			<remove fileExtension=".woff2" />
			<mimeMap fileExtension=".woff" mimeType="font/woff" />
			<mimeMap fileExtension=".woff2" mimeType="font/woff2" />
		</staticContent>
	</system.webServer>

	<!-- Librerías (jQuery, Bootstrap, Font Awesome...) servidas desde el sitio y no de un CDN, para que la pantalla
	     del conductor cargue con mala señal. El nombre lleva la versión: el navegador las guarda 30 días. -->
	<location path="Scripts/lib">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>
	<location path="Content/lib">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
			</staticContent>
		</system.webServer>
	</location>

	<!-- Páginas que reciben varios archivos a la vez (ZIP del correo, PDF de SUNAT): hasta 50 MB por envío
	     (el resto del sitio queda con el límite por defecto de 4 MB). -->
	<location path="Views/BandejaDocumentos.aspx">
		<system.web>
			<httpRuntime maxRequestLength="51200" executionTimeout="300" />
		</system.web>
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="52428800" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>
	<location path="Views/FacturasFlete.aspx">
		<system.web>
			<httpRuntime maxRequestLength="51200" executionTimeout="300" />
		</system.web>
		<system.webServer>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="52428800" />
				</requestFiltering>
			</security>
		</system.webServer>
	</location>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.6.0" newVersion="4.0.6.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime> 
	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701;612;618" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
			<compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008,40000,40008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
		</compilers>
	</system.codedom>
	<system.web.extensions>
		<scripting>
			<webServices>
				<!-- Los [WebMethod] de las páginas responden con JSON; el límite por defecto (100 KB) no
				     alcanza para el recorrido GPS del mapa de SeguimientoViaje (dos tramos de hasta 2 500 puntos). -->
				<jsonSerialization maxJsonLength="4194304" />
			</webServices>
		</scripting>
	</system.web.extensions>
</configuration>