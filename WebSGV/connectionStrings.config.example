       connectionString="Data Source=&lt;servidor&gt;;Initial Catalog=&lt;bd&gt;;User ID=&lt;usuario&gt;;Password=&lt;password&gt;;Encrypt=True;TrustServerCertificate=True;"
       providerName="System.Data.SqlClient" />
</connectionStrings>
