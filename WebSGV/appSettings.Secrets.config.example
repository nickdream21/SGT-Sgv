<?xml version="1.0" encoding="utf-8" ?>
<!--
  Plantilla de los secretos de SGV. Copiar como appSettings.Secrets.config (misma carpeta que Web.config)
  y completar los valores reales. NUNCA subir a git el archivo real (está en .gitignore) ni pegar sus
  valores en el chat. publicar.ps1 no lo sube: el del servidor se actualiza a mano por FTP
  (ver herramientas/publicar/README.md, "Antes y después de publicar").
  Web.config lo carga con <appSettings file="appSettings.Secrets.config">: estas claves se suman a las suyas.
  No poner aquí AvisoErroresLocal (solo se agrega en Web.config de una PC de desarrollo para probar el aviso).
-->
<appSettings>
  <!-- GPS (Onway): credenciales Auth0 de la API. Sin ellas el GPS automático y "Actualizar GPS" fallan. -->
  <add key="OnwayAuth0ClientId" value="&lt;client-id&gt;" />
  <add key="OnwayAuth0ClientSecret" value="&lt;client-secret&gt;" />
  <!-- GPS (Onway): usuario y contraseña de la cuenta con la que se abre la sesión de la API. -->
  <add key="OnwayUsername" value="&lt;usuario&gt;" />
  <add key="OnwayPassword" value="&lt;contrasena&gt;" />

  <!-- Clave que cron-job.org envía en el encabezado X-SGV-Clave (herramientas/gps-automatico/README.md).
       Si no coincide con la de la tarea, el sitio responde 403 y cron-job.org la desactiva.
       publicar.ps1 se niega a compilar el paquete si el archivo local no tiene esta clave. -->
  <add key="GpsAutomaticoClave" value="&lt;clave-larga-aleatoria&gt;" />

  <!-- Token de apisperu.com para buscar DNI/RUC. Vacío: la búsqueda avisa "no está configurada" y se completa a mano. -->
  <add key="ApisPeruToken" value="&lt;token&gt;" />

  <!-- SMTP (Helpers/CorreoHelper.cs): avisos de errores, avisos de liquidaciones y recuperación de contraseña. -->
  <!-- Servidor SMTP, p. ej. smtp.gmail.com. -->
  <add key="SmtpHost" value="&lt;servidor-smtp&gt;" />
  <!-- Puerto; vacío o inválido = 587. -->
  <add key="SmtpPort" value="587" />
  <!-- TLS: solo "false" lo apaga; vacío = true. -->
  <add key="SmtpSSL" value="true" />
  <!-- Cuenta con la que se autentica. -->
  <add key="SmtpUser" value="&lt;cuenta-smtp&gt;" />
  <!-- Contraseña de aplicación de esa cuenta (no la contraseña normal). -->
  <add key="SmtpPass" value="&lt;contrasena-de-aplicacion&gt;" />
  <!-- Remitente (alias verificado de la cuenta); vacío = se usa SmtpUser. -->
  <add key="SmtpFrom" value="&lt;remitente&gt;" />

  <!-- Segundo factor (Helpers/CifradoSecreto.cs): clave maestra con la que se cifran en la BD los secretos TOTP.
       32 bytes aleatorios en base64 (44 caracteres). Generarla con un generador criptográfico en PowerShell:
         $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
       La misma clave en todas las copias que usan la misma BD (sitio publicado y PCs de desarrollo contra esa BD):
       si se pierde o se cambia, los secretos guardados no se pueden descifrar y cada usuario debe volver a enrolarse.
       Vacía: no pasa nada hasta que el segundo factor se use (entonces da un error claro). -->
  <add key="Seguridad.ClaveSegundoFactor" value="" />
</appSettings>
