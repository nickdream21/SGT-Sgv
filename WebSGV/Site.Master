<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebSGV.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Sistema SGV</title>

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <link href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" rel="stylesheet" />
    <link href="~/Content/App.css" rel="stylesheet" />
    <link href="~/Content/responsive-mobile.css" rel="stylesheet" />

    <!-- Librerías base, UNA sola vez y en el head: jQuery → Popper → Bootstrap 4.6.2 → jQuery UI.
         Deben cargarse antes de MainContent porque las páginas usan $.datepicker / .modal() en
         scripts en línea. Las páginas NO deben volver a cargar jQuery ni Bootstrap: una segunda
         copia de jQuery reemplaza $ y desconecta los plugins ya registrados. -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <!-- Estilos para corregir problemas de transparencia -->
    <link href="<%= WebSGV.Helpers.RecursoHelper.Url("~/Content/paginas/SiteMaster.css") %>" rel="stylesheet" />
</head>

<body>
    <form runat="server" autocomplete="off">
        <!-- ScriptManager básico sin scripts personalizados -->
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light" runat="server" id="Navbar">
            <a class="navbar-brand" href="<%= EsAdminGrifo ? ResolveUrl("~/Views/DashboardGrifo.aspx") : (EsAdminSistema ? ResolveUrl("~/Views/DashboardAdminSistema.aspx") : (EsAdmin ? ResolveUrl("~/Views/Inicio.aspx") : ResolveUrl("~/Views/DashboardConductor.aspx"))) %>">
                <i class="fas fa-truck-moving"></i>Sistema SGV
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mr-auto">
                    <!-- ==================== MENÚ PARA ADMIN ==================== -->
                    <% if (EsAdmin)
                        { %>

                    <!-- Despacho -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownDespacho" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-box-open"></i>Despacho
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownDespacho">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroDespacho.aspx") %>'>
                                <i class="fas fa-plus-circle"></i>Agregar Despacho
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/ListaDespachos.aspx") %>'>
                                <i class="fas fa-list-ul"></i>Listar Despachos
                            </a>
                        </div>
                    </li>

                    <!-- Orden de Viaje -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownOrdenViaje" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-route"></i>Orden de Viaje
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownOrdenViaje">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/LiquidacionesPendientes.aspx") %>'>
                                <i class="fas fa-clock"></i>Liquidaciones Pendientes
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/ReportesOrdenesViaje.aspx") %>'>
                                <i class="fas fa-file-invoice-dollar"></i>Reportes
                            </a>
                        </div>
                    </li>

                    <!-- Registro -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownRegistro" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-database"></i>Registro
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownRegistro">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroChoferes.aspx") %>'>
                                <i class="fas fa-user-tie"></i>Conductores
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroTractos.aspx") %>'>
                                <i class="fas fa-truck"></i>Tractos
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroSemiremolques.aspx") %>'>
                                <i class="fas fa-trailer"></i>Semiremolques
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroClientes.aspx") %>'>
                                <i class="fas fa-building"></i>Clientes
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/CatalogoCliente.aspx") %>'>
                                <i class="fas fa-boxes"></i>Cat&#xE1;logo del Cliente
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroPeajes.aspx") %>'>
                                <i class="fas fa-road"></i>Peajes
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroPlantas.aspx") %>'>
                                <i class="fas fa-industry"></i>Plantas
                            </a>
                                </div>
                             </li>

                             <% } %>

                     <!-- ==================== MENÚ EXPORTACIÓN (ADMIN, ADMIN SISTEMA, SUPERVISOR) ==================== -->
                     <% if (EsAdmin || EsAdminSistema || RolUsuario == "SUPERVISOR")
                         { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownExportacion" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-ship"></i>Exportación
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownExportacion">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/Exportacion/DashboardExportacion.aspx") %>'>
                                <i class="fas fa-chart-line"></i>Dashboard Exportación
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/Exportacion/RegistroSeguimiento.aspx") %>'>
                                <i class="fas fa-clipboard-list"></i>Registro Seguimiento
                            </a>
                        </div>
                    </li>
                    <% } %>

                    <!-- ==================== MENÚ EXCLUSIVO ADMINISTRADOR DE SISTEMA ==================== -->
                    <% if (EsAdminSistema)
                        { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownAdminSistema" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-shield-alt"></i>Administración
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownAdminSistema">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/DashboardAdminSistema.aspx") %>'>
                                <i class="fas fa-tachometer-alt"></i>Mi Panel
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/GestionUsuarios.aspx") %>'>
                                <i class="fas fa-users-cog"></i>Gestión de Usuarios
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/Auditoria.aspx") %>'>
                                <i class="fas fa-history"></i>Auditoría del Sistema
                            </a>
                        </div>
                    </li>
                    <% } %>

                    <!-- ==================== MENÚ PARA ADMINISTRADOR DE GRIFO ==================== -->
                    <% if (EsAdminGrifo)
                        { %>

                    <li class="nav-item">
                        <a class="nav-link" href='<%= ResolveUrl("~/Views/DashboardGrifo.aspx") %>'>
                            <i class="fas fa-home"></i>Inicio
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownAbastecimiento" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-gas-pump"></i>Abastecimiento
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownAbastecimiento">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/AgregarAbastecimiento.aspx") %>'>
                                <i class="fas fa-plus-circle"></i>Registrar Abastecimiento
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/BuscarAbastecimiento.aspx") %>'>
                                <i class="fas fa-search"></i>Buscar Abastecimiento
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/ReporteAbastecimiento.aspx") %>'>
                                <i class="fas fa-file-alt"></i>Reporte
                            </a>
                        </div>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownRegistroGrifo" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-database"></i>Registro
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownRegistroGrifo">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroChoferes.aspx") %>'>
                                <i class="fas fa-user-tie"></i>Conductores
                            </a>
                        </div>
                    </li>

                    <% } %>

                    <!-- ==================== MENÚ PARA ADMINISTRADOR DE MAQUINARIA ==================== -->
                    <% if (EsAdminMaquinaria)
                        { %>

                    <li class="nav-item">
                        <a class="nav-link" href='<%= ResolveUrl("~/Views/Inicio.aspx") %>'>
                            <i class="fas fa-home"></i>Inicio
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownRegistroMaquinaria" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-database"></i>Registro
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownRegistroMaquinaria">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroOperadores.aspx") %>'>
                                <i class="fas fa-hard-hat"></i>Operadores
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroEquiposMaquinaria.aspx") %>'>
                                <i class="fas fa-cogs"></i>Equipos / Maquinaria
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroClientesObra.aspx") %>'>
                                <i class="fas fa-building"></i>Clientes de Obra
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroObras.aspx") %>'>
                                <i class="fas fa-hard-hat"></i>Obras
                            </a>
                        </div>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href='<%= ResolveUrl("~/Views/AsignacionesMaquinaria.aspx") %>'>
                            <i class="fas fa-project-diagram"></i>Asignaciones
                        </a>
                    </li>

                    <% } %>

                    <!-- ==================== MENÚ PARA OPERADOR ==================== -->
                    <% if (EsOperador)
                        { %>

                    <li class="nav-item">
                        <a class="nav-link" href='<%= ResolveUrl("~/Views/DashboardOperador.aspx") %>'>
                            <i class="fas fa-hard-hat"></i>Mi Dashboard
                        </a>
                    </li>

                    <% } %>

                    <!-- ==================== MENÚ PARA CONDUCTOR ==================== -->
                    <% if (EsConductor)
                        { %>

                    <li class="nav-item">
                        <a class="nav-link" href='<%= ResolveUrl("~/Views/DashboardConductor.aspx") %>'>
                            <i class="fas fa-home"></i>Inicio
                        </a>
                    </li>

                    <% } %>

                    <!-- Configuración: visible para TODOS los roles -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownConfig" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-cog"></i>Configuración
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownConfig">
                            <a class="dropdown-item" href="#modalCambiarContrasena" data-toggle="modal">
                                <i class="fas fa-key"></i>Cambiar Contraseña
                            </a>
                            <% if (EsAdminSistema) { %>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/Auditoria.aspx") %>'>
                                <i class="fas fa-shield-alt"></i>Auditoría del Sistema
                            </a>
                            <% } %>
                        </div>
                    </li>
                </ul>

                <!-- Información del usuario y botón de cerrar sesión -->
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <span class="navbar-text user-info">
                            <i class="fas fa-user-circle"></i>
                            <%= NombreUsuario %>
                            <span class="badge badge-primary badge-rol"><%= RolUsuario %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <asp:LinkButton ID="btnCerrarSesion" runat="server"
                            CssClass="btn btn-outline-danger btn-sm"
                            OnClick="btnCerrarSesion_Click">
                            <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                        </asp:LinkButton>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Contenido principal -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <!-- Footer -->
        <footer class="footer text-center py-3 mt-5 bg-light">
            <div class="container">
                <p class="mb-0 text-muted">
                    <i class="fas fa-copyright"></i><%: DateTime.Now.Year %> - Sistema SGV | 
                    Usuario: <strong><%= NombreUsuario %></strong> (<%= RolUsuario %>)
                </p>
            </div>
        </footer>

        <!-- Modal Cambiar Contraseña (disponible para todos los roles) -->
        <div class="modal fade" id="modalCambiarContrasena" tabindex="-1" role="dialog" aria-labelledby="modalCambiarContrasenaLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header" style="background:#1e40af;color:white;">
                        <h5 class="modal-title" id="modalCambiarContrasenaLabel">
                            <i class="fas fa-key mr-2"></i>Cambiar Contraseña
                        </h5>
                        <button type="button" class="close js-cerrar-contrasena" data-dismiss="modal" aria-label="Cerrar" style="color:white;">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <asp:Panel ID="pnlMensajeContrasena" runat="server" Visible="false" CssClass="mb-3">
                            <asp:Label ID="lblMensajeContrasena" runat="server"></asp:Label>
                        </asp:Panel>
                        <div class="form-group">
                            <label class="form-label">Contraseña Actual <span class="text-danger">*</span></label>
                            <asp:TextBox ID="txtContrasenaActual" runat="server" CssClass="form-control"
                                TextMode="Password" placeholder="Ingresa tu contraseña actual" autocomplete="current-password"></asp:TextBox>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nueva Contraseña <span class="text-danger">*</span></label>
                            <asp:TextBox ID="txtNuevaContrasena" runat="server" CssClass="form-control"
                                TextMode="Password" placeholder="Mínimo 6 caracteres" autocomplete="new-password"></asp:TextBox>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label">Confirmar Nueva Contraseña <span class="text-danger">*</span></label>
                            <asp:TextBox ID="txtConfirmarContrasena" runat="server" CssClass="form-control"
                                TextMode="Password" placeholder="Repite la nueva contraseña" autocomplete="new-password"></asp:TextBox>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary js-cerrar-contrasena" data-dismiss="modal">Cancelar</button>
                        <asp:Button ID="btnCambiarContrasena" runat="server"
                            Text="Cambiar Contraseña"
                            CssClass="btn btn-primary"
                            OnClick="btnCambiarContrasena_Click"
                            OnClientClick="return validarFormContrasena();" />
                    </div>
                </div>
            </div>
        </div>

        <script src="<%= WebSGV.Helpers.RecursoHelper.Url("~/Scripts/paginas/SiteMaster.js") %>"></script>

    </form>

    <!-- jQuery, Popper, Bootstrap y jQuery UI ya se cargaron en el head -->
    <script src="<%= ResolveUrl("~/Scripts/responsive-mobile.js") %>"></script>

    <script>
        // Valores del servidor que usa el script de la página (ids de controles ASP.NET).
        var SGV = Object.assign(window.SGV || {}, {
            txtContrasenaActual: '<%= txtContrasenaActual.ClientID %>',
            txtNuevaContrasena: '<%= txtNuevaContrasena.ClientID %>',
            txtConfirmarContrasena: '<%= txtConfirmarContrasena.ClientID %>'
        });
    </script>
    <script src="<%= WebSGV.Helpers.RecursoHelper.Url("~/Scripts/paginas/SiteMaster-2.js") %>"></script>

    <!-- ContentPlaceHolder para scripts específicos de página -->
    <asp:ContentPlaceHolder ID="ScriptsSection" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
