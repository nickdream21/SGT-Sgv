<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebSGV.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Sistema SGV</title>

    <!-- CSS -->
    <link href="<%= WebSGV.Helpers.RecursoHelper.Url("~/Content/lib/bootstrap-4.6.2/bootstrap.min.css") %>" rel="stylesheet" />
    <link href="<%= WebSGV.Helpers.RecursoHelper.Url("~/Content/lib/fontawesome-5.15.4/css/all.min.css") %>" rel="stylesheet" />
    <link href="<%= WebSGV.Helpers.RecursoHelper.Url("~/Content/App.css") %>" rel="stylesheet" />
    <link href="<%= WebSGV.Helpers.RecursoHelper.Url("~/Content/sgv-base.css") %>" rel="stylesheet" />

    <!-- Librerías base, UNA sola vez y en el head: jQuery → Popper → Bootstrap 4.6.2 (sin jQuery UI desde
         E5-7: nada lo usaba). Deben cargarse antes de MainContent porque las páginas usan .modal() en
         scripts en línea. Las páginas NO deben volver a cargar jQuery ni Bootstrap: una segunda
         copia de jQuery reemplaza $ y desconecta los plugins ya registrados. -->
    <script src="<%= WebSGV.Helpers.RecursoHelper.Url("~/Scripts/lib/jquery-3.6.4.min.js") %>"></script>
    <script src="<%= WebSGV.Helpers.RecursoHelper.Url("~/Scripts/lib/popper-1.16.1.min.js") %>"></script>
    <script src="<%= WebSGV.Helpers.RecursoHelper.Url("~/Scripts/lib/bootstrap-4.6.2.min.js") %>"></script>

    <!-- Estilos para corregir problemas de transparencia -->
    <link href="<%= WebSGV.Helpers.RecursoHelper.Url("~/Content/paginas/SiteMaster.css") %>" rel="stylesheet" />
</head>

<body>
    <!-- Primer foco con Tab: salta el menú. Va fuera del <form> para que el submit deshabilitado
         siga siendo su primer elemento. Solo se ve al recibir el foco (SiteMaster.css). -->
    <a class="sgv-saltar" href="#contenido">Saltar al contenido</a>
    <form runat="server" autocomplete="off">
        <!-- Botón por defecto deshabilitado: el navegador no envía el formulario con Enter aunque
             SiteMaster.js no cargue o el teclado del celular no avise (si no, Enter usaría el primer
             botón de la página: en el panel del conductor, "Enviar y firmar"). Enter lo maneja
             SiteMaster.js con las zonas data-enter; los DefaultButton van por keypress y siguen igual. -->
        <button type="submit" disabled hidden aria-hidden="true" tabindex="-1"></button>
        <!-- ScriptManager básico sin scripts personalizados -->
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true"
            AllowCustomErrorsRedirect="false" OnAsyncPostBackError="ScriptManager1_AsyncPostBackError" />

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light" runat="server" id="Navbar">
            <a class="navbar-brand" href="<%= ResolveUrl(UrlInicio) %>">
                Sistema SGV
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mr-auto">
                    <!-- ==================== MENÚ PARA ADMIN ==================== -->
                    <% if (EsAdmin)
                        { %>

                    <!-- Despacho -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownDespacho" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Despacho
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownDespacho">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroDespacho.aspx") %>'>
                                Registro de despachos
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/BandejaDocumentos.aspx") %>'>
                                Bandeja de documentos
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/ListaDespachos.aspx") %>'>
                                Lista de despachos
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/DestinoDescarga.aspx") %>'>
                                Destino de descarga
                            </a>
                        </div>
                    </li>
                    <% } %>

                    <!-- ==================== SEGUIMIENTO (ADMIN) ==================== -->
                    <% if (EsAdmin)
                        { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownExportacion" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Seguimiento
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownExportacion">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/Exportacion/RegistroSeguimiento.aspx") %>'>
                                Tablero de seguimiento
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/Exportacion/DashboardExportacion.aspx") %>'>
                                Dashboard de exportaci&#xF3;n
                            </a>
                        </div>
                    </li>
                    <% } %>

                    <% if (EsAdmin)
                        { %>
                    <!-- Liquidaciones -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownOrdenViaje" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Liquidaciones
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownOrdenViaje">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/LiquidacionesPendientes.aspx") %>'>
                                Liquidaciones pendientes
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/SaldosConductores.aspx") %>'>
                                Descuentos y reintegros (quincena)
                            </a>
                            <% if (WebSGV.Services.Liquidaciones.MovimientosViajeService.Habilitado) { %>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/MovimientosViaje.aspx") %>'>
                                Dinero y pagos del viaje
                            </a>
                            <% } %>

                        </div>
                    </li>
                    <% } %>

                    <!-- ==================== REPORTES (ADMIN) ==================== -->
                    <% if (EsAdmin)
                        { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownReportes" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Reportes
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownReportes">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/ReporteCargas.aspx") %>'>
                                Reporte de cargas (pedidos, gu&#xED;as y carga)
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/ReportesOrdenesViaje.aspx") %>'>
                                Reporte de liquidaciones y viajes
                            </a>
                            <% if (EsAdmin)
                                { %>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/FacturasFlete.aspx") %>'>
                                Facturas de flete (conciliaci&#xF3;n)
                            </a>
                            <% } %>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/ReporteGps.aspx") %>'>
                                Reporte GPS por placas
                            </a>
                        </div>
                    </li>
                    <% } %>

                    <% if (EsAdmin)
                        { %>
                    <!-- Catálogos -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownRegistro" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Cat&#xE1;logos
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownRegistro">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroChoferes.aspx") %>'>
                                Conductores
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroTractos.aspx") %>'>
                                Tractos
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroSemiremolques.aspx") %>'>
                                Semirremolques
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroClientes.aspx") %>'>
                                Clientes
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/CatalogoCliente.aspx") %>'>
                                Cat&#xE1;logo del cliente
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroPlantas.aspx") %>'>
                                Plantas
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/RegistroPeajes.aspx") %>'>
                                Peajes
                            </a>
                        </div>
                    </li>
                    <% } %>

                    <!-- ==================== MENÚ EXCLUSIVO ADMINISTRADOR DE SISTEMA ==================== -->
                    <% if (EsAdminSistema)
                        { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownAdminSistema" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Administración
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownAdminSistema">
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/DashboardAdminSistema.aspx") %>'>
                                Panel del sistema
                            </a>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/GestionUsuarios.aspx") %>'>
                                Gestión de usuarios
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/Auditoria.aspx") %>'>
                                Auditoría del sistema
                            </a>
                        </div>
                    </li>
                    <% } %>

                    <!-- ==================== MENÚ PARA CONDUCTOR ==================== -->
                    <% if (EsConductor)
                        { %>

                    <li class="nav-item">
                        <a class="nav-link" href='<%= ResolveUrl("~/Views/DashboardConductor.aspx") %>'>
                            Mi viaje
                        </a>
                    </li>

                    <% } %>

                    <!-- ==================== MENÚ PARA CONTABILIDAD ==================== -->
                    <% if (EsContabilidad)
                        { %>

                    <li class="nav-item">
                        <a class="nav-link" href='<%= ResolveUrl("~/Views/LiquidacionesAprobadasContabilidad.aspx") %>'>
                            Liquidaciones aprobadas
                        </a>
                    </li>

                    <% } %>

                    <!-- Configuración: visible para TODOS los roles -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownConfig" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Configuración
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownConfig">
                            <a class="dropdown-item" href="#modalCambiarContrasena" data-toggle="modal">
                                Cambiar contraseña
                            </a>
                            <% if (MuestraMiSeguridad) { %>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/MiSeguridad.aspx") %>'>
                                Mi seguridad
                            </a>
                            <% } %>
                            <% if (EsAdminSistema) { %>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href='<%= ResolveUrl("~/Views/Auditoria.aspx") %>'>
                                Auditoría del sistema
                            </a>
                            <% } %>
                        </div>
                    </li>
                </ul>

                <!-- Información del usuario y botón de cerrar sesión -->
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <span class="navbar-text user-info">
                            <span class="user-nombre"><%: NombreUsuario %></span>
                            <span class="badge badge-primary badge-rol"><%: RolUsuario %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <asp:LinkButton ID="btnCerrarSesion" runat="server" CausesValidation="false"
                            CssClass="btn btn-outline-danger btn-sm"
                            data-cerrar-sesion="true"
                            data-espera="2"
                            OnClick="btnCerrarSesion_Click">
                            Cerrar sesión
                        </asp:LinkButton>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Contenido principal -->
        <main id="contenido" tabindex="-1" class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <!-- Footer -->
        <footer class="footer text-center py-3 mt-5 bg-light">
            <div class="container">
                <p class="mb-0 text-muted">
                    <%: DateTime.Now.Year %> - Sistema SGV<% if (!string.IsNullOrEmpty(NombreUsuario)) { %> |
                    Usuario: <strong><%: NombreUsuario %></strong> (<%: RolUsuario %>)<% } %>
                </p>
            </div>
        </footer>

        <!-- Modal Cambiar contraseña (disponible para todos los roles) -->
        <div class="modal fade" id="modalCambiarContrasena" tabindex="-1" role="dialog" aria-labelledby="modalCambiarContrasenaLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content" data-enter="<%= btnCambiarContrasena.ClientID %>">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalCambiarContrasenaLabel">
                            Cambiar contraseña
                        </h5>
                        <button type="button" class="close js-cerrar-contrasena" data-dismiss="modal" aria-label="Cerrar">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <asp:Panel ID="pnlMensajeContrasena" runat="server" Visible="false" CssClass="mb-3">
                            <asp:Label ID="lblMensajeContrasena" runat="server"></asp:Label>
                        </asp:Panel>
                        <div id="camposContrasena"></div>
                        <%-- Los campos de contraseña solo existen en la página mientras el modal está abierto
                             (SiteMaster.js clona esta plantilla al abrirlo y la vacía al cerrarlo): con
                             type=password en el formulario único, Edge ofrecía "Contraseñas guardadas" en
                             cualquier buscador. El campo oculto "username" le dice al gestor de contraseñas
                             a qué cuenta pertenece el cambio. Al clonarse conservan su name, así que
                             btnCambiarContrasena_Click los lee igual. --%>
                        <template id="tplCamposContrasena">
                            <input type="text" autocomplete="username" value="<%: UsuarioLogin %>" hidden readonly tabindex="-1" aria-hidden="true" />
                            <div class="form-group">
                                <label for="<%= txtContrasenaActual.ClientID %>" class="sgv-etiqueta">Contraseña actual <span class="sgv-obligatorio" aria-hidden="true">*</span></label>
                                <asp:TextBox ID="txtContrasenaActual" runat="server" aria-required="true" CssClass="form-control"
                                    TextMode="Password" placeholder="Ingresa tu contraseña actual" autocomplete="current-password"></asp:TextBox>
                            </div>
                            <div class="form-group">
                                <label for="<%= txtNuevaContrasena.ClientID %>" class="sgv-etiqueta">Nueva contraseña <span class="sgv-obligatorio" aria-hidden="true">*</span></label>
                                <asp:TextBox ID="txtNuevaContrasena" runat="server" aria-required="true" CssClass="form-control"
                                    TextMode="Password" autocomplete="new-password"></asp:TextBox><%-- placeholder: Page_Load (PasswordHelper.TextoMinimoNueva) --%>
                                <small class="form-text text-muted"><%: WebSGV.Helpers.PoliticaContrasena.TextoAyuda %></small>
                            </div>
                            <div class="form-group mb-0">
                                <label for="<%= txtConfirmarContrasena.ClientID %>" class="sgv-etiqueta">Confirmar nueva contraseña <span class="sgv-obligatorio" aria-hidden="true">*</span></label>
                                <asp:TextBox ID="txtConfirmarContrasena" runat="server" aria-required="true" CssClass="form-control"
                                    TextMode="Password" placeholder="Repite la nueva contraseña" autocomplete="new-password"></asp:TextBox>
                            </div>
                        </template>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary js-cerrar-contrasena" data-dismiss="modal">Cancelar</button>
                        <asp:Button ID="btnCambiarContrasena" runat="server" CausesValidation="false"
                            Text="Cambiar contraseña"
                            CssClass="btn btn-primary"
                            OnClick="btnCambiarContrasena_Click"
                            data-accion="validarFormContrasena" />
                    </div>
                </div>
            </div>
        </div>

        <script src="<%= WebSGV.Helpers.RecursoHelper.Url("~/Scripts/paginas/SiteMaster.js") %>"></script>

    </form>

    <script>
        // Valores del servidor que usa el script de la página (ids de controles ASP.NET).
        var SGV = Object.assign(window.SGV || {}, {
            esRespuestaPost: <%= Request.HttpMethod == "POST" ? "true" : "false" %>,
            urlLogin: '<%= ResolveUrl("~/Views/Login.aspx") %>',
            avisoInicial: '<%= System.Web.HttpUtility.JavaScriptStringEncode(AvisoInicial) %>',
            textoPaginaVencida: '<%= System.Web.HttpUtility.JavaScriptStringEncode(WebSGV.Helpers.ErrorAplicacionHelper.TextoPaginaVencida) %>',
            txtContrasenaActual: '<%= txtContrasenaActual.ClientID %>',
            txtNuevaContrasena: '<%= txtNuevaContrasena.ClientID %>',
            txtConfirmarContrasena: '<%= txtConfirmarContrasena.ClientID %>',
            largoMinimoContrasena: <%= WebSGV.Helpers.PasswordHelper.LargoMinimoNueva %>
        });
    </script>
    <script src="<%= WebSGV.Helpers.RecursoHelper.Url("~/Scripts/paginas/SiteMaster-2.js") %>"></script>

    <!-- ContentPlaceHolder para scripts específicos de página -->
    <asp:ContentPlaceHolder ID="ScriptsSection" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
